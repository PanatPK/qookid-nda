rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // อีเมลแอดมินที่ดูรายชื่อได้ (ต้องสร้างบัญชีใน Firebase Authentication ด้วย)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['admin@qookid.co.th'];
    }

    match /nda_signatures/{docId} {
      // สตาฟส่งได้อย่างเดียว เขียนทับหรือแก้ฉบับที่เซ็นแล้วไม่ได้
      allow create: if request.resource.data.docNo == docId
        && request.resource.data.keys().hasAll(['fullName', 'idCard', 'signature', 'signedAt', 'contractHtml'])
        && request.resource.data.idCard is string && request.resource.data.idCard.size() == 13
        && request.resource.data.signature is string && request.resource.data.signature.size() < 400000
        && request.resource.data.contractHtml.size() < 200000;

      // อ่านได้เฉพาะแอดมิน ไม่มีใครแก้หรือลบผ่านหน้าเว็บ (ลบได้จาก Firebase Console)
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // สำเนาบัตรประชาชนและหน้าบัญชี (รูป JPEG เก็บเป็นข้อความ) ส่งได้อย่างเดียว อ่านได้เฉพาะแอดมิน
    match /nda_files/{fileId} {
      allow create: if request.resource.data.kind in ['idcard', 'bank']
        && fileId == request.resource.data.docNo + '_' + request.resource.data.kind
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // งาน: แอดมินเท่านั้น
    match /jobs/{jobId} {
      allow read, write: if isAdmin();
    }

    // ใบงานรายคน: id เป็นรหัสสุ่ม 24 ตัว ใครมีลิงก์เปิดดูใบงานของตัวเองได้ แต่ค้นรายการทั้งหมดไม่ได้
    // สตาฟแก้ได้อย่างเดียวคือกดรับทราบ (ackAt, ackUA) และกดได้ครั้งเดียว
    match /assignments/{token} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin()
        || (resource.data.ackAt == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackAt', 'ackUA'])
            && request.resource.data.ackAt is string);
    }

    // คอลเลกชันของระบบอื่นในโปรเจกต์เดียวกันให้คงกฎเดิมไว้ด้านล่างนี้
  }
}
